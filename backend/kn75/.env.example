# KN-75: copy thành backend/kn75/.env hoặc thêm vào .env gốc (đã có trong .gitignore)
# Supabase: Project Settings > Database > Connection string (URI)
KN75_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tms
# Đặt true khi kết nối Supabase/Postgres yêu cầu SSL
KN75_PGSSL=false
# Chỉ dùng cho test tự động: DB local riêng, tên kết thúc bằng _test (test sẽ xóa dữ liệu)
KN75_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tms_kn75_test
