# ============================================
# TMS Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/tms_db?schema=public"

# --- Application ---
PORT=3000

# --- SMTP Email ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="\"TMS - Hệ thống Quản lý Đào tạo\" <noreply@tms.vn>"

# --- Frontend URL (dùng cho link trong email) ---
FRONTEND_URL="http://localhost:5500/FE"

# --- Password Reset ---
PASSWORD_RESET_EXPIRY_MINUTES=30
