# ============================================
# TMS Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/tms_db?schema=public"

# --- Application ---
PORT=3000

# --- SMTP Email ---
SMTP_ENABLED=false
SMTP_HOST=mx.tino.vn
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS=true
SMTP_USER=daotaotms@tuoitre24h.com
SMTP_PASS=Quan2006@
SMTP_FROM_EMAIL=ĐÀO TẠO TMS
SMTP_FROM_NAME="Đào tạo TMS"

# --- Frontend URL (dùng cho link trong email) ---
FRONTEND_URL="http://localhost:5500/FE"

# --- Password Reset ---
PASSWORD_RESET_EXPIRY_MINUTES=30
