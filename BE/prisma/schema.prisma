// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Bảng User (tối thiểu cho chức năng auth)
// ============================================
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  role          String   @default("student")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

// ============================================
// KN-40: Bảng password_reset_tokens
// ============================================
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  requestIp String?   @map("request_ip")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([tokenHash], name: "idx_password_reset_token_hash")
  @@index([userId], name: "idx_password_reset_user_id")
  @@map("password_reset_tokens")
}

// ============================================
// KN-47: Bảng audit_logs
// ============================================
model AuditLog {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")
  userId    String?  @map("user_id")
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  String?  // JSON string cho thông tin bổ sung (không chứa dữ liệu nhạy cảm)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([eventType], name: "idx_audit_log_event_type")
  @@index([userId], name: "idx_audit_log_user_id")
  @@index([createdAt], name: "idx_audit_log_created_at")
  @@map("audit_logs")
}
