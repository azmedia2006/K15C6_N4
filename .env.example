# Canonical Express app: copy to .env (never commit actual secrets).
PORT=3000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000
# Local persistent store defaults to backend/data/tms.json.
# TMS_DATA_FILE=/absolute/path/to/tms.json

# Mail disabled unless explicitly configured and enabled.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Đào tạo TMS"

# Optional legacy external integration; NOT used by npm start.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Only required when bootstrapping a NEW datastore with NODE_ENV=production.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
